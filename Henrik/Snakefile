# Metametagraphs: how much does each year of GWAS discoveries reshape the knowledge graph?
# Run: uv run snakemake --cores 1   (settings in config.yaml)

configfile: "config.yaml"


rule all:
    input:
        "results/drift.csv",
        "results/figures/drift.pdf",


rule download_gwas:
    output:
        "data/gwas_catalog.tsv",
    shell:
        """
        curl -sSL --fail -o data/gwas.zip "{config[gwas_url]}"
        unzip -p data/gwas.zip '*.tsv' > {output}
        rm data/gwas.zip
        """


rule parse_gwas:
    input:
        script="scripts/parse_gwas.py",
        catalog="data/gwas_catalog.tsv",
    output:
        "data/edges_gwas.csv",
    shell:
        "python {input.script} {input.catalog} {output} {config[p_threshold]}"


rule drift:
    input:
        script="scripts/drift.py",
        edges="data/edges_gwas.csv",
    output:
        years="results/drift.csv",
        entities="results/drift_entities.csv",
    shell:
        "python {input.script} {input.edges} {output.years} {output.entities}"
        " {config[first_year]} {config[last_year]} {config[dim]} {config[lambda]} {config[n_iter]}"
        " {config[seed]} {config[min_relative_norm]}"


rule plot_drift:
    input:
        script="scripts/plot_drift.py",
        years="results/drift.csv",
    output:
        "results/figures/drift.pdf",
    shell:
        "python {input.script} {input.years} {output}"
